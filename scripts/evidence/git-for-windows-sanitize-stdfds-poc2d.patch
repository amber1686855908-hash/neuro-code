+static int standard_fds_are_valid(void)
+{
+	int fd;
+
+	for (fd = 0; fd <= 2; fd++) {
+		int duplicate = dup(fd);
+
+		if (duplicate < 0)
+			return 0;
+		close(duplicate);
+	}
+	return 1;
+}
